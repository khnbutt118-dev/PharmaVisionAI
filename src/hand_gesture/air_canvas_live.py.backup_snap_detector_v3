def _draw_glass_half(frame, x1, x2, cy, radius, side):
    """Render a glossy translucent capsule shell half with soft 3D shading."""
    if x2 <= x1:
        return
    overlay = frame.copy()
    top, bottom = cy-radius, cy+radius
    if side == "left":
        cap_x = x1 + radius
        color = (205, 175, 105)  # translucent cool-blue shell in BGR
        cv2.rectangle(overlay, (cap_x, top), (x2, bottom), color, -1, cv2.LINE_AA)
        cv2.circle(overlay, (cap_x, cy), radius, color, -1, cv2.LINE_AA)
        cv2.ellipse(overlay, (cap_x, cy), (radius, radius), 0, 90, 270, color, -1, cv2.LINE_AA)
        rim_start, rim_end = 90, 270
        seam_x = x2
    else:
        cap_x = x2 - radius
        color = (155, 115, 225)  # translucent violet-pink shell
        cv2.rectangle(overlay, (x1, top), (cap_x, bottom), color, -1, cv2.LINE_AA)
        cv2.circle(overlay, (cap_x, cy), radius, color, -1, cv2.LINE_AA)
        cv2.ellipse(overlay, (cap_x, cy), (radius, radius), 0, -90, 90, color, -1, cv2.LINE_AA)
        rim_start, rim_end = -90, 90
        seam_x = x1
    cv2.addWeighted(overlay, .48, frame, .52, 0, frame)
    # Dark lower edge and bright upper specular streak create a rounded shell look.
    cv2.ellipse(frame, (cap_x, cy), (radius, radius), 0, rim_start, rim_end,
                (235, 245, 255), 2, cv2.LINE_AA)
    if side == "left":
        cv2.line(frame, (cap_x, top+9), (seam_x, top+9), (245, 255, 255), 3, cv2.LINE_AA)
        cv2.line(frame, (cap_x, bottom-5), (seam_x, bottom-5), (95, 120, 175), 2, cv2.LINE_AA)
        cv2.line(frame, (seam_x, top+5), (seam_x, bottom-5), (230, 250, 255), 3, cv2.LINE_AA)
    else:
        cv2.line(frame, (seam_x, top+9), (cap_x, top+9), (255, 245, 255), 3, cv2.LINE_AA)
        cv2.line(frame, (seam_x, bottom-5), (cap_x, bottom-5), (115, 90, 160), 2, cv2.LINE_AA)
        cv2.line(frame, (seam_x, top+5), (seam_x, bottom-5), (255, 235, 255), 3, cv2.LINE_AA)


def draw_capsule(frame, center, open_amount):
    """Draw a fixed-size, colourful 2.5D transparent capsule and revealed API."""
    cx, cy = int(center[0]), int(center[1])
    # Fixed dimensions: capsule size never responds to hand distance or pinch gap.
    half_len, radius = 142, 43
    separation = int(np.clip(open_amount, 0.0, 1.0) * 150)
    left_shift, right_shift = separation // 2, separation - separation // 2
    left_outer, left_inner = cx-half_len-left_shift, cx-right_shift-2
    right_inner, right_outer = cx+left_shift+2, cx+half_len+right_shift

    # Ground shadow and subtle halo.
    glow = frame.copy()
    cv2.ellipse(glow, (cx, cy+radius+20), (half_len+separation//2+12, 17),
                0, 0, 360, (80, 90, 125), -1, cv2.LINE_AA)
    cv2.addWeighted(glow, .28, frame, .72, 0, frame)

    # Contents remain visible through the tinted shell; when opened, they emerge as a core.
    if open_amount < .82:
        for i in range(17):
            px = cx-91 + (i % 9)*22
            py = cy-17 + (i // 9)*32
            cv2.ellipse(frame, (px, py), (7, 5), (i*19) % 180, 0, 360,
                        (95, 205, 245), -1, cv2.LINE_AA)
            cv2.circle(frame, (px-2, py-2), 2, (230, 250, 255), -1, cv2.LINE_AA)

    _draw_glass_half(frame, left_outer, left_inner, cy, radius, "left")
    _draw_glass_half(frame, right_inner, right_outer, cy, radius, "right")

    cv2.putText(frame, "PARACETAMOL CAPSULE | TRANSLUCENT 3D VIEW",
                (max(12, cx-190), max(135, cy-radius-34)), cv2.FONT_HERSHEY_SIMPLEX,
                .43, (185, 250, 245), 1, cv2.LINE_AA)

    if open_amount >= .18:
        # API payload floats out of the capsule, with a luminous connector.
        api_x = min(W-230, cx+half_len+separation//2+80)
        api_y = max(160, min(H-150, cy-10))
        cv2.line(frame, (right_outer, cy), (api_x-35, api_y), (100, 245, 225), 2, cv2.LINE_AA)
        cv2.circle(frame, (api_x, api_y), 30, (65, 135, 195), -1, cv2.LINE_AA)
        cv2.circle(frame, (api_x, api_y), 30, (150, 255, 245), 2, cv2.LINE_AA)
        for i in range(8):
            a = i*math.pi/4
            q = (int(api_x+18*math.cos(a)), int(api_y+18*math.sin(a)))
            cv2.circle(frame, q, 5, (220, 245, 255), -1, cv2.LINE_AA)
        panel_x = min(W-315, api_x+42)
        panel_y = max(130, min(H-190, api_y-80))
        # Floating futuristic blue glass panel with a soft neon glow.
        glow = frame.copy()
        cv2.rectangle(glow, (panel_x-2, panel_y-2),
                      (panel_x+302, panel_y+160), (255, 110, 25), 8, cv2.LINE_AA)
        cv2.addWeighted(glow, .22, frame, .78, 0, frame)

        # Subtle floating shadow
        cv2.rectangle(frame, (panel_x+5, panel_y+6),
                      (panel_x+305, panel_y+164), (8, 12, 25), -1, cv2.LINE_AA)

        # Dark translucent glass surface
        panel = frame.copy()
        cv2.rectangle(panel, (panel_x, panel_y),
                      (panel_x+300, panel_y+158), (13, 22, 42), -1, cv2.LINE_AA)
        cv2.addWeighted(panel, .91, frame, .09, 0, frame)

        # Electric-blue border and inner highlight
        cv2.rectangle(frame, (panel_x, panel_y),
                      (panel_x+300, panel_y+158), (255, 165, 55), 2, cv2.LINE_AA)
        cv2.rectangle(frame, (panel_x+5, panel_y+5),
                      (panel_x+295, panel_y+153), (255, 95, 30), 1, cv2.LINE_AA)

        # Futuristic corner accents
        for px, py, sx, sy in [
            (panel_x, panel_y, 1, 1),
            (panel_x+300, panel_y, -1, 1),
            (panel_x, panel_y+158, 1, -1),
            (panel_x+300, panel_y+158, -1, -1)
        ]:
            cv2.line(frame, (px, py), (px+sx*20, py), (255, 220, 90), 3, cv2.LINE_AA)
            cv2.line(frame, (px, py), (px, py+sy*20), (255, 220, 90), 3, cv2.LINE_AA)

        # Blue header accent
        cv2.line(frame, (panel_x+12, panel_y+36),
                 (panel_x+288, panel_y+36), (255, 120, 35), 1, cv2.LINE_AA)
        lines = [f"API: {CAPSULE_API['name']}", f"Formula: {CAPSULE_API['formula']}",
                 f"Class: {CAPSULE_API['class']}", f"Use: {CAPSULE_API['use']}",
                 "DEMONSTRATION DATA - VERIFY LABEL"]
        for j, line in enumerate(lines):
            cv2.putText(frame, line, (panel_x+12, panel_y+26+j*27),
                        cv2.FONT_HERSHEY_SIMPLEX, .36 if j < 4 else .27,
                        (120, 255, 225) if j == 0 else (230, 240, 250), 1, cv2.LINE_AA)

    cv2.putText(frame, "INDEX FINGER: MOVE CAPSULE  |  PINCH ON CAPSULE: OPEN / CLOSE",
                (max(12, cx-270), min(H-65, cy+radius+48)), cv2.FONT_HERSHEY_SIMPLEX,
                .34, (225, 235, 250), 1, cv2.LINE_AA)

def draw_hud(frame, canvas, fps, gesture_text, particles):
    out = frame.copy()
    mask = np.any(canvas > 0, axis=2)
    if np.any(mask):
        glow = cv2.GaussianBlur(canvas, (0,0), 9)
        out = cv2.addWeighted(out, 1.0, glow, .30, 0)
        blended = cv2.addWeighted(out, .30, canvas, .70, 0)
        out[mask] = blended[mask]
    layer = out.copy()
    cv2.rectangle(layer, (0,0), (W,70), (12,10,28), -1)
    out = cv2.addWeighted(layer,.86,out,.14,0)
    cv2.putText(out,"PHARMASIGHT | JARVIS GESTURE STUDIO",(16,25),cv2.FONT_HERSHEY_SIMPLEX,.55,(235,245,255),1,cv2.LINE_AA)
    cv2.putText(out,f"MODE: {APP['mode']}   NEON: {'ON' if APP['neon'] else 'OFF'}   SHAPES: {'ON' if APP['shape_snap'] else 'OFF'}",
                (16,52),cv2.FONT_HERSHEY_SIMPLEX,.43,(100,245,220),1,cv2.LINE_AA)
    cv2.putText(out,f"{fps:.0f} FPS | HANDS: {APP['hand_count']}/2",(W-205,27),cv2.FONT_HERSHEY_SIMPLEX,.45,(100,255,220),1,cv2.LINE_AA)
    panel=out.copy(); cv2.rectangle(panel,(14,80),(W-14,119),(12,12,28),-1)
    out=cv2.addWeighted(panel,.78,out,.22,0)
    cv2.putText(out,APP['status'][:105],(24,105),cv2.FONT_HERSHEY_SIMPLEX,.43,(80,235,255),1,cv2.LINE_AA)
    cv2.putText(out,gesture_text[:100],(16,H-40),cv2.FONT_HERSHEY_SIMPLEX,.45,(100,255,210),1,cv2.LINE_AA)
    cv2.putText(out,"D Draw | V Aspirin 3D | K Capsule Explorer | E Neon | H Shapes | C Clear | Z Undo | Y Redo | S Save | Q Quit",
                (16,H-13),cv2.FONT_HERSHEY_SIMPLEX,.34,(225,230,245),1,cv2.LINE_AA)
    particles.render(out)
    return out


def main():
    global INK
    if not MODEL_PATH.exists():
        print("Hand landmark model not found:", MODEL_PATH); return
    cam=cv2.VideoCapture(0,cv2.CAP_DSHOW)
    if not cam.isOpened(): cam.release(); cam=cv2.VideoCapture(0)
    if not cam.isOpened(): print("Cannot open webcam."); return
    cam.set(cv2.CAP_PROP_FRAME_WIDTH,W); cam.set(cv2.CAP_PROP_FRAME_HEIGHT,H)
    canvas=np.zeros((H,W,3),np.uint8); undo=[]; redo=[]; particles=ParticleSystem()
    previous={}; strokes={}; last_gestures={}
    yaw,pitch,mol_scale=0.0,0.0,1.0; mol_center=[W//2,H//2+8]
    capsule_center=[W//2, H//2+5]; capsule_open=0.0; capsule_open_target=0.0
    capsule_drag_offset=None; capsule_dragging=False; capsule_last_gesture="MOVE"
    prev_index=None; prev_gap=None; prev_two_angle=None; prev_two_span=None
    start=time.perf_counter(); frames=0
    # Snap color cycle: white -> red -> dark blue -> white.
    snap_colors = [(255, 255, 255), (0, 0, 255), (139, 0, 0)]
    snap_color_index = 0
    INK = snap_colors[snap_color_index]
    snap_state = {'contact': None, 'last_snap': 0.0}
    window="PharmaSight AI - JARVIS Gesture Studio"
    cv2.namedWindow(window,cv2.WINDOW_NORMAL); cv2.resizeWindow(window,W,H)
    options=mp.tasks.vision.HandLandmarkerOptions(
        base_options=mp.tasks.BaseOptions(model_asset_path=str(MODEL_PATH)),
        running_mode=mp.tasks.vision.RunningMode.VIDEO, num_hands=2,
        min_hand_detection_confidence=.55,min_hand_presence_confidence=.55,
        min_tracking_confidence=.55)
    print("Studio running. D=Draw, V=Aspirin 3D, K=Capsule Explorer, E=Neon, H=Shapes, Q=Quit")
    print("Capsule: index finger moves capsule at fixed size; pinch on capsule opens/closes it.")
    print("Molecule: index fingertip moves and rotates; thumb-index gap zooms; two hands twist and scale.")
    try:
        with mp.tasks.vision.HandLandmarker.create_from_options(options) as tracker:
            while True:
                ok,frame=cam.read()
                if not ok:
                    APP['status']="Webcam frame unavailable"; print(APP['status']); break
                frame=cv2.resize(cv2.flip(frame,1),(W,H))
                rgb=cv2.cvtColor(frame,cv2.COLOR_BGR2RGB)
                mp_image=mp.Image(image_format=mp.ImageFormat.SRGB,data=rgb)
                timestamp=int((time.perf_counter()-start)*1000)
                result=tracker.detect_for_video(mp_image,timestamp)
                hands=result.hand_landmarks or []; APP['hand_count']=len(hands)
                hand_points=[]; gesture_labels=[]
                for idx,lm in enumerate(hands):
                    gesture=classify(lm)
                    # The user's mirrored webcam feed reports handedness reversed; swap it for display.
                    raw="UNKNOWN"
                    if result.handedness and idx<len(result.handedness) and result.handedness[idx]:
                        raw=result.handedness[idx][0].category_name.upper()
                    label={"LEFT":"RIGHT","RIGHT":"LEFT"}.get(raw,raw)
                    pts=draw_hand(frame,lm,label,gesture)
                    hand_points.append((lm,pts,gesture,label))
                    gesture_labels.append(f"{label}: {gesture}")
                # Gesture-driven visual effects.
                for idx,(lm,pts,gesture,label) in enumerate(hand_points):
                    old=last_gestures.get(idx,"MOVE"); tip=pts[8]
                    # Detect thumb-middle contact followed by a fast release.
                    # Only the primary hand in drawing mode can change brush color.
                    if APP['mode'] == 'DRAW' and idx == 0:
                        now = time.perf_counter()
                        thumb_middle = dist2d(lm[4], lm[12])
                        thumb_index = dist2d(lm[4], lm[8])
                        middle_pos = (lm[12].x, lm[12].y)
                        contact = snap_state['contact']
                        if contact is None:
                            if thumb_middle < 0.055 and thumb_index > 0.075:
                                snap_state['contact'] = (now, middle_pos)
                        else:
                            contact_time, contact_pos = contact
                            elapsed_snap = now - contact_time
                            movement = float(np.hypot(
                                middle_pos[0] - contact_pos[0],
                                middle_pos[1] - contact_pos[1]))
                            if elapsed_snap > 0.45:
                                snap_state['contact'] = None
                            elif (thumb_middle > 0.085 and movement > 0.018
                                  and now - snap_state['last_snap'] > 0.65):
                                snap_color_index = (snap_color_index + 1) % len(snap_colors)
                                INK = snap_colors[snap_color_index]
                                snap_state['last_snap'] = now
                                snap_state['contact'] = None
                    else:
                        snap_state['contact'] = None
                    if gesture=="OPEN" and old!="OPEN":
                        particles.burst(tip[0],tip[1],42); APP['status']=f"{label} hand: particle burst"
                    elif gesture=="PINCH":
                        particles.trail(tip[0],tip[1],5)
                        cv2.circle(frame,tip,21,(255,130,60),2,cv2.LINE_AA)
                    elif gesture=="POINT": particles.trail(tip[0],tip[1],2)
                    last_gestures[idx]=gesture

                if hand_points:
                    lm,pts,gesture,label=hand_points[0]; cursor=pts[8]
                    old=previous.get('primary_gesture','MOVE')
                    if APP['mode']=="DRAW":
                        if gesture=="POINT":
                            if old!="POINT": take_snapshot(canvas,undo,redo); strokes[0]=[]
                            prev=previous.get('draw_cursor')
                            if prev is not None:
                                if APP['neon']: neon_line(canvas,prev,cursor,color=INK)
                                else: cv2.line(canvas,prev,cursor,INK,5,cv2.LINE_AA)
                            strokes.setdefault(0,[]).append(cursor); previous['draw_cursor']=cursor
                        elif gesture=="PINCH":
                            if old!="PINCH": take_snapshot(canvas,undo,redo)
                            cv2.circle(canvas,cursor,28,(0,0,0),-1,cv2.LINE_AA)
                        else:
                            previous.pop('draw_cursor',None)
                            if old=="POINT" and APP['shape_snap']:
                                shape=detect_shape(strokes.get(0,[]))
                                if shape: draw_shape(canvas,shape,strokes.get(0,[]))
                                else: APP['status']="No clear shape detected - draw a larger closed shape"
                            strokes[0]=[]
                    elif APP['mode']=="MOLECULE":
                        # Absolute index position moves the model around the full camera workspace.
                        target=(int(np.clip(cursor[0],90,W-90)),int(np.clip(cursor[1],165,H-95)))
                        mol_center[0]=int(.72*mol_center[0]+.28*target[0])
                        mol_center[1]=int(.72*mol_center[1]+.28*target[1])
                        # Thumb-index separation is a continuous pinch-to-zoom control.
                        gap=dist2d(lm[4],lm[8])*W
                        if prev_gap is not None:
                            mol_scale=float(np.clip(mol_scale+(gap-prev_gap)*.009,.42,2.7))
                        prev_gap=gap
                        # Index movement also rotates the 3D structure.
                        if prev_index is not None:
                            dx=cursor[0]-prev_index[0]; dy=cursor[1]-prev_index[1]
                            yaw+=dx*.0045; pitch=float(np.clip(pitch+dy*.0035,-1.35,1.35))
                        prev_index=cursor
                        # Two-hand span scales; the angle between hands twists the model.
                        if len(hand_points)>=2:
                            p1=np.array(hand_points[0][1][8],float); p2=np.array(hand_points[1][1][8],float)
                            vec=p2-p1; span=float(np.linalg.norm(vec)); angle=math.atan2(vec[1],vec[0])
                            if prev_two_span is not None:
                                mol_scale=float(np.clip(mol_scale+(span-prev_two_span)*.006,.42,2.7))
                            if prev_two_angle is not None:
                                da=(angle-prev_two_angle+math.pi)%(2*math.pi)-math.pi
                                yaw+=da
                            prev_two_span=span; prev_two_angle=angle
                        else:
                            prev_two_span=None; prev_two_angle=None
                        APP['status']=f"ASPIRIN 3D | Scale {mol_scale:.2f}x | Move index to position/rotate; open/close pinch to zoom"
                    elif APP["mode"]=="CAPSULE":
                        # POINT (one index finger) picks up and moves the fixed-size capsule.
                        # PINCH on the capsule toggles its opening animation; pinch distance
                        # is deliberately NOT used for scaling.
                        cx, cy = capsule_center
                        inside_capsule = (abs(cursor[0]-cx) < 178 and abs(cursor[1]-cy) < 78)
                        pinch_mid = ((pts[4][0]+pts[8][0])//2, (pts[4][1]+pts[8][1])//2)
                        inside_pinch = (abs(pinch_mid[0]-cx) < 185 and abs(pinch_mid[1]-cy) < 85)

                        if gesture == "POINT":
                            if capsule_drag_offset is None and inside_capsule:
                                capsule_drag_offset = (cx-cursor[0], cy-cursor[1])
                                capsule_dragging = True
                            if capsule_drag_offset is not None:
                                target_x = int(np.clip(cursor[0]+capsule_drag_offset[0], 175, W-175))
                                target_y = int(np.clip(cursor[1]+capsule_drag_offset[1], 175, H-150))
                                capsule_center[0] = int(.78*capsule_center[0] + .22*target_x)
                                capsule_center[1] = int(.78*capsule_center[1] + .22*target_y)
                                APP['status'] = "Capsule | Moving with index finger | Fixed size"
                        else:
                            if capsule_drag_offset is not None:
                                APP['status'] = "Capsule position set"
                            capsule_drag_offset = None
                            capsule_dragging = False

                        if gesture == "PINCH" and capsule_last_gesture != "PINCH" and inside_pinch:
                            capsule_open_target = 0.0 if capsule_open_target > .5 else 1.0
                            APP['status'] = ("Capsule opening | Paracetamol API revealed" if capsule_open_target > .5
                                             else "Capsule closing")
                        capsule_last_gesture = gesture
                        capsule_open += (capsule_open_target-capsule_open)*.16
                        if abs(capsule_open_target-capsule_open) < .012:
                            capsule_open = capsule_open_target
                        if gesture == "PINCH" and not inside_pinch:
                            APP['status'] = "Move index finger onto capsule, then pinch to open it"
                    previous['primary_gesture']=gesture
                else:
                    previous.pop('draw_cursor',None); previous['primary_gesture']='MOVE'
                    prev_index=None; prev_gap=None
                    prev_two_span=None; prev_two_angle=None
                    if APP['mode'] == 'CAPSULE':
                        capsule_drag_offset=None; capsule_dragging=False; capsule_last_gesture='MOVE'

                if APP['mode']=="MOLECULE":
                    draw_aspirin(frame,yaw,pitch,mol_scale,mol_center)
                elif APP['mode']=="CAPSULE":
                    draw_capsule(frame, capsule_center, capsule_open)
                frames+=1; elapsed=time.perf_counter()-start; fps=frames/elapsed if elapsed>0 else 0
                display=draw_hud(frame,canvas,fps," | ".join(gesture_labels) if gesture_labels else "Show one or two hands",particles)
                cv2.imshow(window,display)
                key=cv2.waitKey(1)&0xFF
                if 65<=key<=90: key+=32
                # Q is the only keyboard shortcut that exits the studio.
                if key==ord('q'): break
                elif key==ord('d'):
                    APP['mode']='DRAW'; APP['status']='Draw | Index finger draws | Pinch erases'
                    previous.clear(); strokes.clear(); prev_index=None; prev_gap=None
                elif key==ord('v'):
                    APP['mode']='MOLECULE'; APP['status']='Aspirin 3D | Index moves/rotates; pinch zooms; two hands twist/scale'
                    previous.clear(); prev_index=None; prev_gap=None; prev_two_span=None; prev_two_angle=None
                elif key==ord('k'):
                    APP['mode']='CAPSULE'; APP['status']='Capsule Explorer | Index finger moves; pinch on capsule opens/closes it'
                    previous.clear(); prev_index=None; prev_gap=None; capsule_drag_offset=None; capsule_dragging=False; capsule_last_gesture='MOVE'
                elif key==ord('e'):
                    APP['neon']=not APP['neon']; APP['status']='Neon brush '+('ON' if APP['neon'] else 'OFF')
                elif key==ord('h'):
                    APP['shape_snap']=not APP['shape_snap']; APP['status']='Smart shapes '+('ON' if APP['shape_snap'] else 'OFF')
                elif key==ord('c'):
                    if np.any(canvas): take_snapshot(canvas,undo,redo); canvas[:]=0
                    strokes.clear(); APP['status']='Canvas cleared'
                elif key==ord('z'):
                    if undo: redo.append(canvas.copy()); canvas=undo.pop(); APP['status']='Undo'
                elif key==ord('y'):
                    if redo: undo.append(canvas.copy()); canvas=redo.pop(); APP['status']='Redo'
                elif key==ord('s'): save_canvas(canvas)
    except Exception as exc:
        print('STUDIO ERROR:',type(exc).__name__,str(exc)); APP['status']=f"Studio error: {type(exc).__name__}: {exc}"
    finally:
        cam.release(); cv2.destroyAllWindows(); print('Webcam released. Studio closed.')


if __name__=="__main__":
    main()

